          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Willian Douglas Ferreira1813098\",\n  \"clienteDesde\": \"2026-11-12\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"clienteId\", body.id);",
              "pm.test(\"ID criado\", () => pm.expect(body.id).to.be.above(0));",
              "pm.test(\"Nome e RU\", () => pm.expect(pm.response.json().nome).to.eql(\"Willian Douglas Ferreira1813098\"));"
            ]
          }
        }
      ],
